<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Editar Post</title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  <style>
    body { background-color: #111827; color: #f3f4f6; padding-top: 50px; }
    .form-container { background-color: #1f2937; padding: 40px; border-radius: 16px; border: 1px solid #374151; box-shadow: 0 10px 25px rgba(0,0,0,0.3); }
    h5 { color: #fbbf24; font-weight: 600; margin-bottom: 30px; }
    label { color: #9ca3af !important; }
    input, textarea { color: #ffffff !important; border-bottom: 1px solid #4b5563 !important; }
    input:focus, textarea:focus { border-bottom: 1px solid #fbbf24 !important; box-shadow: 0 1px 0 0 #fbbf24 !important; }
    .btn-update { background-color: #fbbf24 !important; color: #111827 !important; font-weight: 700; border-radius: 6px; width: 100%; margin-top: 20px; }
  </style>
</head>
<body class="container" style="margin-top: 50px;">
  <h4>Editar Publicación</h4>
  <div class="container">
    <div class="row">
      <div class="col s12 m8 offset-m2 form-container">
        <h5 class="center-align"><i class="material-icons left" style="font-size: 2rem;">edit</i>EDITAR PUBLICACIÓN</h5>
        <form action="/posts/edit/<%= post._id %>" method="POST">
          
          <div class="row">
            <div class="input-field col s12">
              <input id="title" name="title" type="text" required minlength="5" maxlength="30" value="<%= post.title %>">
              <label for="title" class="active">Título de la Publicación</label>
            </div>
          </div>

          <div class="row">
            <div class="input-field col s12">
              <textarea id="content" name="content" class="materialize-textarea" required minlength="10"><%= post.content %></textarea>
              <label for="content" class="active">Bloque de Contenido</label>
            </div>
          </div>

          <div class="row">
            <div class="input-field col s12">
              <input id="hashtags" name="hashtags" type="text" value="<%= post.hashtags ? post.hashtags.join(', ') : '' %>">
              <label for="hashtags" class="active">Hashtags Relacionados</label>
            </div>
          </div>

          <div class="row">
            <div class="input-field col s12">
              <input id="imageUrl" name="imageUrl" type="url" value="<%= post.imageUrl || '' %>">
              <label for="imageUrl" class="active">Hipervínculo de la Imagen (URL)</label>
            </div>
          </div>

          <div class="row">
            <div class="col s12">
              <button class="btn waves-effect waves-light btn-update" type="submit">Actualizar Cambios</button>
              <a href="/posts" class="btn-flat grey-text center-align" style="display:block; margin-top: 15px; font-weight: 500;">Descartar Cambios</a>
            </div>
          </div>

        </form>
      </div>
    </div>
  </div>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
</body>
</html>